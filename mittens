systemd_router_action() {
  local action="$1"
  case "$action" in
    start|stop|restart)
      systemctl --user "$action" mittens-router.service
      ;;
    status)
      systemctl --user status mittens-router.service --no-pager -l
      ;;
    logs)
      journalctl --user -u mittens-router.service -n 200 --no-pager
      ;;
    *)
      die "unknown systemd router action '$action'"
