main() {
  local category="${1:-help}"
  if [[ $# -gt 0 ]]; then
    shift
  fi

  case "$category" in
    help|-h|--help)
      usage
      ;;
    init)
      init_cmd "$@"
      ;;
    router)
      local action="${1:-}"
      [[ $# -gt 0 ]] && shift
      case "$action" in
        on) router_on "$@" ;;
        systemd)
          local systemd_action="${1:-}"
          [[ $# -gt 0 ]] && shift
          case "$systemd_action" in
            on) systemd_router_install "$@" ;;
            off) systemd_router_uninstall ;;
            start|stop|restart|status|logs) systemd_router_action "$systemd_action" ;;
            *) die "unknown router systemd action '$systemd_action'" ;;
          esac
          ;;
        *) die "unknown router action '$action' (expected: on|systemd)" ;;
      esac
      ;;
    server)
      local action="${1:-}"
      [[ $# -gt 0 ]] && shift
      case "$action" in
        on) server_on "$@" ;;
        systemd)
          local systemd_action="${1:-}"
          [[ $# -gt 0 ]] && shift
          case "$systemd_action" in
            on) systemd_backend_install "$@" ;;
            off) systemd_backend_uninstall "$@" ;;
            start|stop|restart|status|logs) systemd_backend_action "$systemd_action" "$@" ;;
            *) die "unknown server systemd action '$systemd_action'" ;;
          esac
          ;;
        *) die "unknown server action '$action' (expected: on|systemd)" ;;
      esac
      ;;
    renderer)
      local action="${1:-}"
      [[ $# -gt 0 ]] && shift
      case "$action" in
        on) run_renderer_foreground "$@" ;;
        systemd)
          local systemd_action="${1:-}"
          [[ $# -gt 0 ]] && shift
          case "$systemd_action" in
            on) systemd_renderer_install "$@" ;;
            off) systemd_renderer_uninstall "$@" ;;
            start|stop|restart|status|logs) systemd_renderer_action "$systemd_action" "$@" ;;
            *) die "unknown renderer systemd action '$systemd_action'" ;;
          esac
          ;;
        *)
          die "unknown renderer action '$action' (expected: on|systemd)"
          ;;
      esac
      ;;
    nginx)
      local action="${1:-}"
      [[ $# -gt 0 ]] && shift
      case "$action" in
        snippet) nginx_snippet "$@" ;;
        *) die "unknown nginx action '$action'" ;;
      esac
      ;;
    *)
      die "unknown command '$category'"
      ;;
  esac
}

main "$@"
