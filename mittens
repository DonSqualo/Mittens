systemd_disable_and_remove_unit() {
  local unit_name="$1"
  local unit_path="$DEFAULT_SYSTEMD_USER_DIR/$unit_name"
  systemctl --user disable --now "$unit_name" >/dev/null 2>&1 || true
  rm -f "$unit_path"
}

cleanup_legacy_backend_unit() {
  local backend_id="$1"
  local current_unit
  current_unit="$(systemd_backend_unit_name "$backend_id")"
  local legacy_unit
  legacy_unit="$(systemd_backend_unit_name "${backend_id}_")"
  if [[ "$legacy_unit" != "$current_unit" ]]; then
    systemd_disable_and_remove_unit "$legacy_unit"
  fi
}

cleanup_legacy_renderer_unit() {
  local renderer_id="$1"
  local current_unit
  current_unit="$(systemd_renderer_unit_name "$renderer_id")"
  local legacy_unit
  legacy_unit="$(systemd_renderer_unit_name "${renderer_id}_")"
  if [[ "$legacy_unit" != "$current_unit" ]]; then
    systemd_disable_and_remove_unit "$legacy_unit"
  fi
}

