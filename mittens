#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$SCRIPT_DIR"
SERVER_DIR="$REPO_ROOT/server"

DEFAULT_REGISTRY_PATH="${HOME:-/tmp}/.mittens/backends.json"
DEFAULT_ROUTER_PORT="3100"
DEFAULT_RENDERER_HOST="0.0.0.0"
DEFAULT_RUNTIME_DIR="${HOME:-/tmp}/.mittens/runtime"
DEFAULT_BACKEND_LOG_DIR="$DEFAULT_RUNTIME_DIR/backends"
DEFAULT_ROUTER_LOG="$DEFAULT_RUNTIME_DIR/router.log"
DEFAULT_ROUTER_PID_FILE="$DEFAULT_RUNTIME_DIR/router.pid"
DEFAULT_PROJECTS_ROOT="${MITTENS_PROJECTS_ROOT:-${HOME:-/tmp}/projects}"
DEFAULT_SYSTEMD_USER_DIR="${HOME:-/tmp}/.config/systemd/user"

usage() {
  cat <<'EOF'
Usage:
  # Canonical surface:
  mittens init PROJECT.lua [--backend-id ID] [--projects-root PATH] [--worktree PATH] [--registry PATH] [--router-port N] [--renderer-id ID] [--renderer-port N] [--renderer-host HOST] [--backend-port N] [--owner NAME] [--branch NAME] [--nginx-snippet-output FILE] [--nginx-service NAME] [--no-nginx]

  mittens router on [--registry PATH] [--port N] [--log FILE] [--pid-file FILE]
  mittens router systemd on [--registry PATH] [--port N]
  mittens router systemd off
  mittens router systemd start|stop|restart|status|logs

  mittens server on --backend-id ID --project-file FILE [--projects-root PATH] [--backend-port N] [--worktree PATH] [--owner NAME] [--branch NAME] [--registry PATH] [--log-dir DIR]
  mittens server systemd on --backend-id ID --project-file FILE [--projects-root PATH] [--backend-port N] [--worktree PATH] [--owner NAME] [--branch NAME] [--registry PATH]
  mittens server systemd off --backend-id ID
  mittens server systemd start|stop|restart|status|logs --backend-id ID

  mittens renderer on --renderer-id ID --worktree PATH --port N [--host HOST]
  mittens renderer systemd on --renderer-id ID --worktree PATH --port N [--host HOST]
  mittens renderer systemd off --renderer-id ID
  mittens renderer systemd start|stop|restart|status|logs --renderer-id ID

  mittens nginx snippet [--router-port N] [--output FILE]
  mittens help
EOF
}

die() {
  echo "error: $*" >&2
  exit 1
}

ensure_runtime_dirs() {
  mkdir -p "$DEFAULT_RUNTIME_DIR" "$DEFAULT_BACKEND_LOG_DIR"
}

ensure_parent_dir() {
  local path="$1"
  mkdir -p "$(dirname "$path")"
}

ensure_registry_parent_dir() {
  local registry_path="$1"
  ensure_parent_dir "$registry_path"
}

ensure_registry_bin() {
  (cd "$SERVER_DIR" && cargo build --quiet --no-default-features --bin backend_registry)
}

ensure_router_bin() {
  (cd "$SERVER_DIR" && cargo build --quiet --no-default-features --bin router_service)
}

ensure_backend_bin_for_worktree() {
  local worktree="$1"
  (cd "$worktree/server" && cargo build --quiet --release --bin mittens-server)
}

registry_bin_path() {
  echo "$SERVER_DIR/target/debug/backend_registry"
}

router_bin_path() {
  echo "$SERVER_DIR/target/debug/router_service"
}

registry_cmd_with_build() {
  local registry_path="$1"
  shift
  ensure_registry_parent_dir "$registry_path"
  ensure_registry_bin
  MITTENS_REGISTRY_PATH="$registry_path" "$(registry_bin_path)" "$@"
}

registry_cmd_no_build() {
  local registry_path="$1"
  shift
  ensure_registry_parent_dir "$registry_path"
  local bin_path
  bin_path="$(registry_bin_path)"
  [[ -x "$bin_path" ]] || die "backend_registry binary not found at $bin_path (run a build/install first)"
  MITTENS_REGISTRY_PATH="$registry_path" "$bin_path" "$@"
}

registry_cmd() {
  registry_cmd_with_build "$@"
}

parse_flags() {
  local -n out_ref="$1"
  shift
  out_ref=()
  while [[ $# -gt 0 ]]; do
    local key="$1"
    shift
    if [[ "$key" != --* ]]; then
      die "invalid flag '$key' (expected --key value)"
    fi
    if [[ $# -eq 0 ]]; then
      die "missing value for '$key'"
    fi
    out_ref["$key"]="$1"
    shift
  done
}

get_flag() {
  local -n map_ref="$1"
  local key="$2"
  local default_value="${3:-}"
  if [[ -n "${map_ref[$key]+x}" ]]; then
    echo "${map_ref[$key]}"
  else
    echo "$default_value"
  fi
}

require_flag() {
  local -n map_ref="$1"
  local key="$2"
  if [[ -z "${map_ref[$key]+x}" ]]; then
    die "missing required flag '$key'"
  fi
  echo "${map_ref[$key]}"
}

pid_is_alive() {
  local pid="$1"
  kill -0 "$pid" 2>/dev/null
}

default_backend_port_from_id() {
  local backend_id="$1"
  if [[ "$backend_id" =~ ([0-9]+)$ ]]; then
    echo $((4200 + ${BASH_REMATCH[1]}))
    return
  fi
  local hash
  hash="$(printf "%s" "$backend_id" | cksum | awk '{print $1}')"
  echo $((4201 + (hash % 99)))
}

resolve_project_file() {
  local raw_path="$1"
  local projects_root="$2"

  local projects_root_abs
  projects_root_abs="$(readlink -f "$projects_root" 2>/dev/null || true)"
  [[ -n "$projects_root_abs" ]] || die "projects root not found: $projects_root"

  local candidate="$raw_path"
  if [[ "$candidate" != /* ]]; then
    candidate="${projects_root_abs}/${candidate}"
  fi

  local candidate_abs
  candidate_abs="$(readlink -f "$candidate" 2>/dev/null || true)"
  [[ -n "$candidate_abs" ]] || die "project file not found: $candidate"

  case "$candidate_abs" in
    "$projects_root_abs"/*) ;;
    *) die "project file must be under projects root '$projects_root_abs': $candidate_abs" ;;
  esac

  echo "$candidate_abs"
}

require_no_whitespace() {
  local name="$1"
  local value="$2"
  if [[ "$value" =~ [[:space:]] ]]; then
    die "$name contains whitespace, unsupported for generated systemd unit: $value"
  fi
}

sanitize_unit_id() {
  local value="$1"
  printf "%s" "$value" | tr -c 'A-Za-z0-9_.@-' '_'
}

default_backend_id_from_project() {
  local project_file="$1"
  local base
  base="$(basename "$project_file")"
  base="${base%.lua}"
  sanitize_unit_id "$base"
}

manifold_ld_library_path_for_worktree() {
  local worktree="$1"
  local bindings_dir
  local src_dir
  bindings_dir="$(ls -d "$worktree"/server/target/release/build/manifold3d-sys-*/out/build/bindings/c 2>/dev/null | head -n 1 || true)"
  src_dir="$(ls -d "$worktree"/server/target/release/build/manifold3d-sys-*/out/build/src 2>/dev/null | head -n 1 || true)"
  if [[ -z "$bindings_dir" || -z "$src_dir" ]]; then
    return 1
  fi
  echo "$bindings_dir:$src_dir"
}

set_backend_unit_ld_library_path() {
  local backend_id="$1"
  local worktree="$2"
  local unit_path
  unit_path="$(systemd_backend_unit_path "$backend_id")"
  [[ -f "$unit_path" ]] || die "backend unit file not found: $unit_path"

  local ld_path
  ld_path="$(manifold_ld_library_path_for_worktree "$worktree" || true)"
  [[ -n "$ld_path" ]] || die "could not resolve manifold runtime library paths under '$worktree/server/target/release/build'"

  if grep -q '^Environment=LD_LIBRARY_PATH=' "$unit_path"; then
    sed -i "s|^Environment=LD_LIBRARY_PATH=.*|Environment=LD_LIBRARY_PATH=$ld_path|" "$unit_path"
  else
    awk -v line="Environment=LD_LIBRARY_PATH=$ld_path" '
      {
        print $0
        if ($0 ~ /^Environment=PATH=/) {
          print line
        }
      }
    ' "$unit_path" >"$unit_path.tmp"
    mv "$unit_path.tmp" "$unit_path"
  fi
}

enable_nginx_service() {
  local service_name="$1"
  command -v nginx >/dev/null 2>&1 || die "nginx binary not found in PATH (install nginx or run init with --no-nginx)"
  command -v systemctl >/dev/null 2>&1 || die "systemctl not found (run init with --no-nginx on non-systemd environments)"
  systemctl enable --now "$service_name" >/dev/null 2>&1 || die "failed to enable/start nginx service '$service_name' (try running with appropriate privileges)"
  systemctl reload "$service_name" >/dev/null 2>&1 || systemctl restart "$service_name" >/dev/null 2>&1 || die "failed to reload/restart nginx service '$service_name'"
}

init_cmd() {
  local project_file=""
  local backend_id=""
  local projects_root="$REPO_ROOT"
  local worktree="$REPO_ROOT"
  local registry_path="$DEFAULT_REGISTRY_PATH"
  local router_port="$DEFAULT_ROUTER_PORT"
  local renderer_id="local"
  local renderer_port="3000"
  local renderer_host="$DEFAULT_RENDERER_HOST"
  local backend_port=""
  local owner="${USER:-unknown}"
  local branch=""
  local nginx_snippet_output="${HOME:-/tmp}/.mittens/nginx/mittens-router.conf"
  local nginx_service="nginx"
  local enable_nginx="1"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --backend-id) backend_id="${2:-}"; shift 2 ;;
      --projects-root) projects_root="${2:-}"; shift 2 ;;
      --worktree) worktree="${2:-}"; shift 2 ;;
      --registry) registry_path="${2:-}"; shift 2 ;;
      --router-port) router_port="${2:-}"; shift 2 ;;
      --renderer-id) renderer_id="${2:-}"; shift 2 ;;
      --renderer-port) renderer_port="${2:-}"; shift 2 ;;
      --renderer-host) renderer_host="${2:-}"; shift 2 ;;
      --backend-port) backend_port="${2:-}"; shift 2 ;;
      --owner) owner="${2:-}"; shift 2 ;;
      --branch) branch="${2:-}"; shift 2 ;;
      --nginx-snippet-output) nginx_snippet_output="${2:-}"; shift 2 ;;
      --nginx-service) nginx_service="${2:-}"; shift 2 ;;
      --no-nginx) enable_nginx="0"; shift ;;
      --*)
        die "unknown init flag '$1'"
        ;;
      *)
        if [[ -z "$project_file" ]]; then
          project_file="$1"
        else
          die "unexpected positional argument '$1' (expected only PROJECT.lua)"
        fi
        shift
        ;;
    esac
  done

  [[ -n "$project_file" ]] || die "missing required PROJECT.lua argument"
  [[ -n "$backend_id" ]] || backend_id="$(default_backend_id_from_project "$project_file")"
  [[ -n "$backend_port" ]] || backend_port="$(default_backend_port_from_id "$backend_id")"
  project_file="$(resolve_project_file "$project_file" "$projects_root")"
  systemd_require_user

  # Migrate from old unit naming behavior that could append an extra underscore.
  cleanup_legacy_renderer_unit "$renderer_id"
  cleanup_legacy_backend_unit "$backend_id"
  systemctl --user daemon-reload

  echo "init: router systemd on (port=$router_port)"
  systemd_router_install --registry "$registry_path" --port "$router_port"

  echo "init: renderer systemd on (id=$renderer_id port=$renderer_port)"
  systemd_renderer_install --renderer-id "$renderer_id" --worktree "$worktree" --port "$renderer_port" --host "$renderer_host"

  echo "init: backend systemd on (id=$backend_id port=$backend_port project=$project_file)"
  systemd_backend_install \
    --backend-id "$backend_id" \
    --project-file "$project_file" \
    --projects-root "$projects_root" \
    --backend-port "$backend_port" \
    --worktree "$worktree" \
    --owner "$owner" \
    --branch "$branch" \
    --registry "$registry_path"

  set_backend_unit_ld_library_path "$backend_id" "$worktree"
  systemctl --user daemon-reload
  systemctl --user reset-failed "$(systemd_backend_unit_name "$backend_id")" >/dev/null 2>&1 || true
  systemctl --user restart "$(systemd_backend_unit_name "$backend_id")"
  systemctl --user restart "mittens-router.service"

  mkdir -p "$(dirname "$nginx_snippet_output")"
  nginx_snippet --router-port "$router_port" --output "$nginx_snippet_output"
  if [[ "$enable_nginx" == "1" ]]; then
    enable_nginx_service "$nginx_service"
    echo "init: nginx enabled and reloaded (service=$nginx_service)"
  else
    echo "init: nginx skipped (--no-nginx)"
  fi

  echo "init complete"
  echo "open: http://localhost:${renderer_port}/?backend_id=${backend_id}"
}

ensure_renderer_deps_for_worktree() {
  local worktree="$1"
  local renderer_dir="$worktree/renderer"
  [[ -d "$renderer_dir" ]] || die "renderer directory not found: $renderer_dir"
  local vite_bin="$renderer_dir/node_modules/.bin/vite"
  [[ -x "$vite_bin" ]] || die "renderer dependencies missing in $renderer_dir (expected $vite_bin, run: cd $renderer_dir && npm install)"
}

router_start() {
  local -A flags
  parse_flags flags "$@"

  local registry_path
  registry_path="$(get_flag flags --registry "$DEFAULT_REGISTRY_PATH")"
  local router_port
  router_port="$(get_flag flags --port "$DEFAULT_ROUTER_PORT")"
  local router_log
  router_log="$(get_flag flags --log "$DEFAULT_ROUTER_LOG")"
  local router_pid_file
  router_pid_file="$(get_flag flags --pid-file "$DEFAULT_ROUTER_PID_FILE")"

  ensure_runtime_dirs
  ensure_parent_dir "$router_log"
  ensure_parent_dir "$router_pid_file"
  ensure_router_bin

  if [[ -f "$router_pid_file" ]]; then
    local existing_pid
    existing_pid="$(cat "$router_pid_file" 2>/dev/null || true)"
    if [[ -n "$existing_pid" ]] && pid_is_alive "$existing_pid"; then
      die "router already running (pid=$existing_pid)"
    fi
    rm -f "$router_pid_file"
  fi

  nohup "$REPO_ROOT/mittens" router on \
    --foreground "1" \
    --registry "$registry_path" \
    --port "$router_port" >"$router_log" 2>&1 &
  local pid="$!"
  echo "$pid" >"$router_pid_file"

  sleep 0.4
  if ! pid_is_alive "$pid"; then
    rm -f "$router_pid_file"
    die "router failed to start, see log: $router_log"
  fi

  echo "router started pid=$pid port=$router_port registry=$registry_path"
  echo "log: $router_log"
}

router_stop() {
  local -A flags
  parse_flags flags "$@"
  local router_pid_file
  router_pid_file="$(get_flag flags --pid-file "$DEFAULT_ROUTER_PID_FILE")"

  if [[ ! -f "$router_pid_file" ]]; then
    die "router pid file not found: $router_pid_file"
  fi

  local pid
  pid="$(cat "$router_pid_file")"
  if pid_is_alive "$pid"; then
    kill "$pid"
    sleep 0.2
    if pid_is_alive "$pid"; then
      kill -9 "$pid" || true
    fi
    echo "router stopped pid=$pid"
  else
    echo "router not running (stale pid file)"
  fi
  rm -f "$router_pid_file"
}

router_status() {
  local -A flags
  parse_flags flags "$@"
  local router_pid_file
  router_pid_file="$(get_flag flags --pid-file "$DEFAULT_ROUTER_PID_FILE")"
  local router_port
  router_port="$(get_flag flags --port "$DEFAULT_ROUTER_PORT")"

  if [[ ! -f "$router_pid_file" ]]; then
    echo "router: stopped"
    return 1
  fi

  local pid
  pid="$(cat "$router_pid_file")"
  if ! pid_is_alive "$pid"; then
    echo "router: stopped (stale pid file)"
    return 1
  fi

  echo "router: running pid=$pid port=$router_port"
  if command -v curl >/dev/null 2>&1; then
    if curl -fsS "http://127.0.0.1:${router_port}/healthz" >/dev/null 2>&1; then
      echo "router health: ok"
    else
      echo "router health: unreachable"
    fi
  fi
}

is_truthy() {
  local raw="$1"
  case "${raw,,}" in
    1|true|yes|on) return 0 ;;
    *) return 1 ;;
  esac
}

router_on() {
  local -A flags
  parse_flags flags "$@"
  local foreground
  foreground="$(get_flag flags --foreground "0")"

  local forwarded=()
  local key
  for key in "${!flags[@]}"; do
    if [[ "$key" != "--foreground" ]]; then
      forwarded+=("$key" "${flags[$key]}")
    fi
  done

  if is_truthy "$foreground"; then
    run_router_foreground "${forwarded[@]}"
    return
  fi
  router_start "${forwarded[@]}"
}

backend_start() {
  local -A flags
  parse_flags flags "$@"

  local backend_id
  backend_id="$(require_flag flags --backend-id)"
  local project_file
  project_file="$(require_flag flags --project-file)"
  local projects_root
  projects_root="$(get_flag flags --projects-root "$DEFAULT_PROJECTS_ROOT")"
  local registry_path
  registry_path="$(get_flag flags --registry "$DEFAULT_REGISTRY_PATH")"
  local worktree
  worktree="$(get_flag flags --worktree "$REPO_ROOT")"
  local owner
  owner="$(get_flag flags --owner "${USER:-unknown}")"
  local branch
  branch="$(get_flag flags --branch "")"
  local backend_port
  backend_port="$(get_flag flags --backend-port "$(default_backend_port_from_id "$backend_id")")"
  local log_dir
  log_dir="$(get_flag flags --log-dir "$DEFAULT_BACKEND_LOG_DIR")"

  project_file="$(resolve_project_file "$project_file" "$projects_root")"
  ensure_runtime_dirs
  mkdir -p "$log_dir"

  if [[ -z "$branch" ]]; then
    branch="$(git -C "$worktree" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")"
  fi

  local backend_log="${log_dir}/${backend_id}.log"
  ensure_backend_bin_for_worktree "$worktree"
  ensure_registry_bin

  nohup "$REPO_ROOT/mittens" server on \
    --foreground "1" \
    --backend-id "$backend_id" \
    --project-file "$project_file" \
    --projects-root "$projects_root" \
    --backend-port "$backend_port" \
    --worktree "$worktree" \
    --owner "$owner" \
    --branch "$branch" \
    --registry "$registry_path" >"$backend_log" 2>&1 &
  local backend_pid="$!"

  sleep 0.4
  if ! pid_is_alive "$backend_pid"; then
    die "backend failed to start backend_id=$backend_id, see log: $backend_log"
  fi

  local ws_url="ws://127.0.0.1:${backend_port}/ws"
  echo "backend started id=$backend_id pid=$backend_pid port=$backend_port"
  echo "project: $project_file"
  echo "ws_url: $ws_url"
  echo "log: $backend_log"
}

server_on() {
  local -A flags
  parse_flags flags "$@"
  local foreground
  foreground="$(get_flag flags --foreground "0")"

  local forwarded=()
  local key
  for key in "${!flags[@]}"; do
    if [[ "$key" != "--foreground" ]]; then
      forwarded+=("$key" "${flags[$key]}")
    fi
  done

  if is_truthy "$foreground"; then
    run_backend_foreground "${forwarded[@]}"
    return
  fi
  backend_start "${forwarded[@]}"
}

backend_stop() {
  local -A flags
  parse_flags flags "$@"
  local backend_id
  backend_id="$(require_flag flags --backend-id)"
  local registry_path
  registry_path="$(get_flag flags --registry "$DEFAULT_REGISTRY_PATH")"

  local pid
  pid="$(registry_cmd "$registry_path" field --backend-id "$backend_id" --name pid 2>/dev/null || true)"
  if [[ -n "$pid" ]] && pid_is_alive "$pid"; then
    kill "$pid"
    sleep 0.2
    if pid_is_alive "$pid"; then
      kill -9 "$pid" || true
    fi
    echo "backend stopped id=$backend_id pid=$pid"
  else
    echo "backend pid not running for id=$backend_id"
  fi

  registry_cmd "$registry_path" remove --backend-id "$backend_id" >/dev/null
  echo "backend unregistered id=$backend_id"
}

backend_status() {
  local -A flags
  parse_flags flags "$@"
  local registry_path
  registry_path="$(get_flag flags --registry "$DEFAULT_REGISTRY_PATH")"

  local backend_id
  backend_id="$(get_flag flags --backend-id "")"
  if [[ -n "$backend_id" ]]; then
    registry_cmd "$registry_path" get --backend-id "$backend_id"
    local pid
    pid="$(registry_cmd "$registry_path" field --backend-id "$backend_id" --name pid 2>/dev/null || true)"
    if [[ -n "$pid" ]] && pid_is_alive "$pid"; then
      echo "process_status=alive pid=$pid"
    else
      echo "process_status=dead"
    fi
    return
  fi

  registry_cmd "$registry_path" list
}

backend_list() {
  local -A flags
  parse_flags flags "$@"
  local registry_path
  registry_path="$(get_flag flags --registry "$DEFAULT_REGISTRY_PATH")"
  registry_cmd "$registry_path" list
}

run_router_foreground() {
  local -A flags
  parse_flags flags "$@"
  local registry_path
  registry_path="$(get_flag flags --registry "$DEFAULT_REGISTRY_PATH")"
  local router_port
  router_port="$(get_flag flags --port "$DEFAULT_ROUTER_PORT")"

  ensure_registry_parent_dir "$registry_path"
  local router_bin
  router_bin="$(router_bin_path)"
  [[ -x "$router_bin" ]] || die "router_service binary not found at $router_bin (run router install/start first)"
  MITTENS_REGISTRY_PATH="$registry_path" MITTENS_ROUTER_PORT="$router_port" "$router_bin"
}

run_backend_foreground() {
  local -A flags
  parse_flags flags "$@"

  local backend_id
  backend_id="$(require_flag flags --backend-id)"
  local project_file
  project_file="$(require_flag flags --project-file)"
  local projects_root
  projects_root="$(get_flag flags --projects-root "$DEFAULT_PROJECTS_ROOT")"
  local registry_path
  registry_path="$(get_flag flags --registry "$DEFAULT_REGISTRY_PATH")"
  local worktree
  worktree="$(get_flag flags --worktree "$REPO_ROOT")"
  local owner
  owner="$(get_flag flags --owner "${USER:-unknown}")"
  local branch
  branch="$(get_flag flags --branch "")"
  local backend_port
  backend_port="$(get_flag flags --backend-port "$(default_backend_port_from_id "$backend_id")")"

  project_file="$(resolve_project_file "$project_file" "$projects_root")"
  if [[ -z "$branch" ]]; then
    branch="$(git -C "$worktree" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")"
  fi

  ensure_registry_parent_dir "$registry_path"

  local ws_url="ws://127.0.0.1:${backend_port}/ws"
  local backend_bin="$worktree/server/target/release/mittens-server"
  [[ -x "$backend_bin" ]] || die "backend binary not found at $backend_bin (run backend install/start first)"
  local registry_bin
  registry_bin="$(registry_bin_path)"
  [[ -x "$registry_bin" ]] || die "backend_registry binary not found at $registry_bin (run backend install/start first)"
  local run_pid="$$"

  registry_cmd_no_build "$registry_path" upsert \
    --backend-id "$backend_id" \
    --ws-url "$ws_url" \
    --project-file "$project_file" \
    --branch "$branch" \
    --owner "$owner" \
    --worktree "$worktree" \
    --backend-port "$backend_port" \
    --pid "$run_pid" >/dev/null

  trap 'registry_cmd_no_build "'"$registry_path"'" remove --backend-id "'"$backend_id"'" >/dev/null 2>&1 || true' EXIT INT TERM

  cd "$worktree"
  MITTENS_PORT="$backend_port" "$backend_bin" "$project_file"
}

run_renderer_foreground() {
  local -A flags
  parse_flags flags "$@"
  local renderer_id
  renderer_id="$(require_flag flags --renderer-id)"
  local worktree
  worktree="$(require_flag flags --worktree)"
  local port
  port="$(require_flag flags --port)"
  local host
  host="$(get_flag flags --host "$DEFAULT_RENDERER_HOST")"

  require_no_whitespace "renderer_id" "$renderer_id"
  require_no_whitespace "worktree" "$worktree"
  require_no_whitespace "port" "$port"
  require_no_whitespace "host" "$host"

  ensure_renderer_deps_for_worktree "$worktree"

  local renderer_dir="$worktree/renderer"
  local vite_bin="$renderer_dir/node_modules/.bin/vite"
  local renderer_branch
  renderer_branch="$(git -C "$worktree" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")"
  cd "$renderer_dir"
  VITE_MITTENS_RENDERER_ID="$renderer_id" \
  VITE_MITTENS_RENDERER_BRANCH="$renderer_branch" \
  "$vite_bin" --host "$host" --port "$port" --strictPort
}

nginx_snippet() {
  local -A flags
  parse_flags flags "$@"
  local router_port
  router_port="$(get_flag flags --router-port "$DEFAULT_ROUTER_PORT")"
  local output_file
  output_file="$(get_flag flags --output "")"

  local snippet
  snippet="$(cat <<EOF
# Mittens Router Service
# Route all backend websocket requests by backend_id.
location /ws/ {
    proxy_http_version 1.1;
    proxy_set_header Upgrade \$http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host \$host;
    proxy_pass http://127.0.0.1:${router_port};
}

# Backend discovery endpoint.
location = /api/backends {
    proxy_pass http://127.0.0.1:${router_port}/api/backends;
}

# Router graph API endpoint.
location = /api/graph {
    proxy_pass http://127.0.0.1:${router_port}/api/graph;
}

# Human-readable graph menu.
location = /graph {
    proxy_pass http://127.0.0.1:${router_port}/graph;
}
EOF
)"

  if [[ -n "$output_file" ]]; then
    printf "%s\n" "$snippet" >"$output_file"
    echo "wrote nginx snippet: $output_file"
  else
    printf "%s\n" "$snippet"
  fi
}

systemd_require_user() {
  command -v systemctl >/dev/null 2>&1 || die "systemctl not found"
}

systemd_router_unit_path() {
  echo "$DEFAULT_SYSTEMD_USER_DIR/mittens-router.service"
}

systemd_backend_unit_name() {
  local backend_id="$1"
