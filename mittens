#!/usr/bin/env bash
#
# mittens - Launch Mittens CAD environment
#
# Usage: mittens -f <file.lua> [options]
#
# Starts the Rust server (scriptcad-server) and Vite renderer for
# interactive CAD development with hot-reload.
#

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SERVER_DIR="$SCRIPT_DIR/server"
RENDERER_DIR="$SCRIPT_DIR/renderer"

# Defaults
LUA_FILE=""
SERVER_PORT=3001
RENDERER_PORT=3000
BASE_PATH="/"
REBUILD=false
RESTART=false

# Colors (disabled if not a terminal)
if [[ -t 1 ]]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    BLUE='\033[0;34m'
    BOLD='\033[1m'
    NC='\033[0m'
else
    RED='' GREEN='' YELLOW='' BLUE='' BOLD='' NC=''
fi

log()     { echo -e "${BLUE}[mittens]${NC} $1"; }
success() { echo -e "${GREEN}[mittens]${NC} $1"; }
warn()    { echo -e "${YELLOW}[mittens]${NC} $1"; }
error()   { echo -e "${RED}[mittens]${NC} $1" >&2; exit 1; }

usage() {
    cat <<EOF
${BOLD}Usage:${NC} mittens -f <file.lua> [options]

${BOLD}Options:${NC}
  -f, --file <path>       Lua file to load (required)
  -s, --server <port>     Server WebSocket port (default: 3001)
  -r, --renderer <port>   Renderer port (default: 3000)
  -b, --base <path>       Base URL path for renderer (default: /)
      --rebuild           Force rebuild server with cargo
      --restart           Force stop existing processes on ports
  -h, --help              Show this help

${BOLD}Examples:${NC}
  mittens -f examples/basic/cube.lua
  mittens -f ~/projects/design.lua -s 4001 -r 4000
  mittens -f test.lua --rebuild --restart

${BOLD}Requirements:${NC}
  - Rust/Cargo (for server)
  - Node.js/npm (for renderer)
EOF
    exit 0
}

# Check if a command exists
has_cmd() { command -v "$1" &>/dev/null; }

# Check if port is in use
port_in_use() {
    local port=$1
    if has_cmd lsof; then
        lsof -i :"$port" &>/dev/null
    elif has_cmd ss; then
        ss -tuln | grep -q ":$port "
    elif has_cmd netstat; then
        netstat -tuln | grep -q ":$port "
    else
        # Fallback: try to connect
        (echo >/dev/tcp/localhost/"$port") 2>/dev/null
    fi
}

# Kill process on port
kill_port() {
    local port=$1
    if has_cmd fuser; then
        fuser -k "$port"/tcp 2>/dev/null || true
    elif has_cmd lsof; then
        local pid
        pid=$(lsof -t -i :"$port" 2>/dev/null || true)
        [[ -n "$pid" ]] && kill "$pid" 2>/dev/null || true
    fi
}

# Stop processes (handles pm2 if present)
stop_processes() {
    if [[ "$RESTART" == true ]]; then
        log "Stopping existing processes..."
        
        # Try pm2 first (if available and processes exist)
        if has_cmd pm2; then
            pm2 delete "mittens-server" "mittens-renderer" \
                "private-mittens-server" "private-mittens-renderer" 2>/dev/null || true
        fi
        
        # Kill anything on our ports
        kill_port "$SERVER_PORT"
        kill_port "$RENDERER_PORT"
        sleep 1
    else
        # Just check if ports are available
        if port_in_use "$SERVER_PORT"; then
            error "Port $SERVER_PORT in use. Use --restart to force, or -s <port> for different port."
        fi
        if port_in_use "$RENDERER_PORT"; then
            error "Port $RENDERER_PORT in use. Use --restart to force, or -r <port> for different port."
        fi
    fi
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -f|--file)     LUA_FILE="$2"; shift 2 ;;
        -s|--server)   SERVER_PORT="$2"; shift 2 ;;
        -r|--renderer) RENDERER_PORT="$2"; shift 2 ;;
        -b|--base)     BASE_PATH="$2"; shift 2 ;;
        --rebuild)     REBUILD=true; shift ;;
        --restart)     RESTART=true; shift ;;
        -h|--help)     usage ;;
        -*)            error "Unknown option: $1" ;;
        *)             
            # Positional arg - treat as file if -f not given
            [[ -z "$LUA_FILE" ]] && LUA_FILE="$1" || error "Unknown argument: $1"
            shift ;;
    esac
done

# Validate Lua file
[[ -z "$LUA_FILE" ]] && error "No Lua file specified. Use: mittens -f <file.lua>"

# Resolve relative paths
if [[ ! -f "$LUA_FILE" ]]; then
    # Try relative to script dir
    if [[ -f "$SCRIPT_DIR/$LUA_FILE" ]]; then
        LUA_FILE="$SCRIPT_DIR/$LUA_FILE"
    else
        error "File not found: $LUA_FILE"
    fi
fi
LUA_FILE="$(cd "$(dirname "$LUA_FILE")" && pwd)/$(basename "$LUA_FILE")"

# Check dependencies
has_cmd cargo || error "cargo not found. Install Rust: https://rustup.rs"
has_cmd npm   || error "npm not found. Install Node.js: https://nodejs.org"

# Build server if needed
SERVER_BIN="$SERVER_DIR/target/release/scriptcad-server"
if [[ "$REBUILD" == true ]] || [[ ! -x "$SERVER_BIN" ]]; then
    log "Building server (this may take a minute)..."
    cd "$SERVER_DIR"
    if cargo build --release 2>&1 | while IFS= read -r line; do
        echo -e "${YELLOW}[cargo]${NC} $line"
    done; then
        success "Server built successfully"
    else
        error "Server build failed"
    fi
fi

# Find manifold library
MANIFOLD_LIB=$(find "$SERVER_DIR/target/release/build" -path "*/manifold3d-sys-*/out/lib" -type d 2>/dev/null | head -1)
if [[ -n "$MANIFOLD_LIB" ]]; then
    export LD_LIBRARY_PATH="${MANIFOLD_LIB}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi

# Install renderer dependencies if needed
if [[ ! -d "$RENDERER_DIR/node_modules" ]]; then
    log "Installing renderer dependencies..."
    cd "$RENDERER_DIR"
    npm install
fi

# Stop existing processes
stop_processes

# Cleanup on exit
cleanup() {
    echo ""
    log "Shutting down..."
    [[ -n "${SERVER_PID:-}" ]] && kill "$SERVER_PID" 2>/dev/null || true
    [[ -n "${RENDERER_PID:-}" ]] && kill "$RENDERER_PID" 2>/dev/null || true
    wait 2>/dev/null || true
    success "Stopped"
}
trap cleanup EXIT INT TERM

# Start server
log "Starting server..."
cd "$SERVER_DIR"
"$SERVER_BIN" "$LUA_FILE" 2>&1 | while IFS= read -r line; do
    if [[ "$line" == *"ERROR"* ]] || [[ "$line" == *"error"* ]]; then
        echo -e "${RED}[server]${NC} $line"
    elif [[ "$line" == *"WARN"* ]]; then
        echo -e "${YELLOW}[server]${NC} $line"
    elif [[ "$line" == *"INFO"* ]]; then
        echo -e "${GREEN}[server]${NC} $line"
    else
        echo -e "${BLUE}[server]${NC} $line"
    fi
done &
SERVER_PID=$!

# Wait for server
log "Waiting for server on port $SERVER_PORT..."
for _ in {1..60}; do
    if ! kill -0 "$SERVER_PID" 2>/dev/null; then
        error "Server failed to start"
    fi
    if port_in_use "$SERVER_PORT"; then
        success "Server ready"
        break
    fi
    sleep 0.5
done

# Start renderer
log "Starting renderer..."
cd "$RENDERER_DIR"
npm run dev -- --host 0.0.0.0 --port "$RENDERER_PORT" --base "$BASE_PATH" 2>&1 | while IFS= read -r line; do
    echo -e "${BLUE}[renderer]${NC} $line"
done &
RENDERER_PID=$!

# Wait for renderer
for _ in {1..30}; do
    if port_in_use "$RENDERER_PORT"; then
        success "Renderer ready"
        break
    fi
    sleep 0.5
done

# Print summary
echo ""
echo -e "${BOLD}Mittens running!${NC}"
echo ""
echo -e "  ${GREEN}Renderer:${NC}  http://localhost:$RENDERER_PORT$BASE_PATH"
echo -e "  ${GREEN}WebSocket:${NC} ws://localhost:$SERVER_PORT/ws"
echo -e "  ${GREEN}File:${NC}      $LUA_FILE"
echo ""
echo -e "  ${BOLD}Tip:${NC} Edit your Lua file - changes hot-reload automatically"
echo ""
log "Press Ctrl+C to stop"

# Wait for processes
wait
