  router_port="$(get_flag flags --port "$DEFAULT_ROUTER_PORT")"

  systemd_require_user
  mkdir -p "$DEFAULT_SYSTEMD_USER_DIR"
  ensure_registry_parent_dir "$registry_path"
  ensure_router_bin

  local unit_path
  unit_path="$(systemd_router_unit_path)"
  cat >"$unit_path" <<EOF
[Unit]
Description=Mittens Router Service
After=network.target

[Service]
Type=simple
WorkingDirectory=$REPO_ROOT
ExecStart=$REPO_ROOT/mittens router on --foreground 1 --registry $registry_path --port $router_port
Restart=always
RestartSec=1
Environment=HOME=${HOME:-/tmp}
Environment=PATH=/usr/local/bin:/usr/bin:/bin:${HOME:-/tmp}/.cargo/bin

[Install]
WantedBy=default.target
EOF

  systemctl --user daemon-reload
  systemctl --user enable --now mittens-router.service
  echo "installed and started mittens-router.service"
}

systemd_router_uninstall() {
